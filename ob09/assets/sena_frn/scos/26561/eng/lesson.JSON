correct_feedback": [{"content": "Whoops! Something important is missing.", "type": "text"}, {"content": "Maybe next time...", "type": "text"}]}, "type": "feedback"}, {"type": "learning_skills", "contents": [{"content": "Reading", "type": "skill"}, {"content": "Writing", "type": "skill"}, {"content": "Speaking", "type": "skill"}, {"content": "Listening", "type": "skill"}]}, {"type": "post_instructions", "contents": [{"content": "Consignes : Compl\u00e9tez les \u00e9tapes suivantes. Remplissez la grille d'auto-\u00e9valuation.", "type": "text"}]}], "type": "DWS", "template_override": 1}], "stimuli": [{"_data": [], "type": "welcome", "contents": [{}], "template_override": 1, "id": 0}, {"id": 1, "title": "", "contents": [{"value": {"images": [{"text": "", "id": 0, "time": "0", "image": "frn5le11ob09re2img05.jpg"}, {"text": "<span class=\"strong\">Charlotte</span> :\tPierre, j'ai un peu froid en terrasse. On ne pourrait pas s'asseoir \u00e0 l'int\u00e9rieur&nbsp;?</br>\n<span class=\"strong\">Pierre</span> :\tOui, pourquoi pas.</br>\n<span class=\"strong\">Charlotte</span> :\tMerci.</br>\n<span class=\"strong\">Pierre</span> :\t\tPersonnellement, je ne pense pas qu'il fasse si froid dehors.</br>\n<span class=\"strong\">Charlotte</span> :\tIl y a un peu de vent, et je ne voudrais pas m'enrhumer.</br>\n<span class=\"strong\">Pierre</span> :\t\tEn tout cas\u2026 Comment va ton nouveau travail ? Tu as rencontr\u00e9 tous tes nouveaux coll\u00e8gues ?</br>\n<span class=\"strong\">Charlotte</span> :\tOui. J'ai eu une journ\u00e9e tr\u00e8s productive.</br>\n<span class=\"strong\">Pierre</span> :\t\t\u00c7a me fait plaisir.", "id": 1, "time": "100", "image": "frn5le11ob09re2img05.jpg"}, {"text": "<span class=\"strong\">Serveur</span>\t: Excusez-moi de vous interrompre. Est-ce que vous avez choisi&nbsp;? </br>\n<span class=\"strong\">Charlotte</span> :\tOn pourrait avoir encore quelques minutes&nbsp;?</br>\n<span class=\"strong\">Serveur</span>\t: Bien s\u00fbr. Voudriez-vous quelque chose \u00e0 boire en attendant ?</br>\n<span class=\"strong\">Charlotte</span> :\tPour moi, ce sera une limonade.</br>\n<span class=\"strong\">Pierre</span> :\t\tJe voudrais une bouteille d'eau gazeuse, s'il vous pla\u00eet.", "id": 2, "time": "21000", "image": "frn5le11ob09re2img06.jpg"}, {"text": "<span class=\"strong\">Serveur</span>\t: Est-ce que je peux prendre votre commande&nbsp;?</br>\n<span class=\"strong\">Pierre</span> :\t\tJe voudrais une bonne blanquette de veau !</br>\n<span class=\"strong\">Serveur</span>\t: Certainement. Et pour vous, Madame ?</br>\n<span class=\"strong\">Charlotte</span> :\tAuriez-vous quelque chose de l\u00e9ger ? J'aurais besoin de vos recommandations.</br>\n<span class=\"strong\">Serveur</span>\t: Nous avons de tr\u00e8s bonnes salades compos\u00e9es, et des assortiments de crudit\u00e9s.</br>\n<span class=\"strong\">Charlotte</span> :\tJ'ai envie de crudit\u00e9s ce soir. </br>\n<span class=\"strong\">Serveur</span> :\tCe sera tout ?</br>\n<span class=\"strong\">Charlotte</span> :\tOui, merci.", "id": 3, "time": "33300", "image": "frn5le11ob09re2img01.jpg"}], "audiosrc": "frn5le11ob09re2aud01", "coverimg": "frn5le11ob09re2img05.jpg"}, "type": "slideshow"}], "_data": [], "type": "audio", "template_override": 1}]}]}